# Django
SECRET_KEY=your-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://ado:ado_secret@db:5432/adorchestrator
POSTGRES_DB=adorchestrator
POSTGRES_USER=ado
POSTGRES_PASSWORD=ado_secret

# Redis
REDIS_URL=redis://redis:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Temporal
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default

# Mock Platforms
MOCK_PLATFORM_BASE_URL=http://mock-platforms:8090

# AI provider configuration (provider-specific model identifiers are deployment settings)
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434
AI_VISION_MODEL=
AI_TEXT_MODEL=
AI_API_KEY=
AI_REQUEST_TIMEOUT=60
